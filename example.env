# NOTE: this file is sourced by bash. No spaces around '='; quote any value
# containing spaces, '#' or other special characters.
# Booleans accept true/false/1/0/yes/no/y/n.
# Location: put this file next to run.sh as .env. To use another path, set it in
# the shell (it cannot be set inside this file):  ENV_FILE=/path/to/file ./run.sh

# ---------- REQUIRED ----------
GITHUB_USER=
GITHUB_TOKEN=               # classic PAT: repo, read:org, admin:repo_hook, admin:org_hook, gist, read:project
GITEA_URL=                  # must be https:// (see ALLOW_INSECURE_HTTP); trailing slash is stripped
GITEA_USER=
GITEA_TOKEN=                # read:user, write:user (projects), write:repository, write:organization

# ---------- SAFETY ----------
FORCE_PRIVATE=false         # true = force all destinations private; false = follow GitHub visibility
ORG_VISIBILITY=auto         # auto|private|limited|public (new orgs only). auto = private if FORCE_PRIVATE=true, else PUBLIC. public/limited + FORCE_PRIVATE=true = startup error
ALLOW_INSECURE_HTTP=false   # true only for a trusted isolated network (plain http://)

# ---------- WHAT TO MIGRATE (all default true) ----------
MIGRATE_REPOS=true
MIGRATE_ORGS=true
MIGRATE_GISTS=true
MIGRATE_ISSUES=true
MIGRATE_PULL_REQUESTS=true
MIGRATE_RELEASES=true
MIGRATE_LABELS=true
MIGRATE_MILESTONES=true
MIGRATE_WIKI=true
MIGRATE_LFS=true
MIGRATE_WEBHOOKS=true
MIGRATE_ORG_WEBHOOKS=true
MIGRATE_DEPLOY_KEYS=true
MIGRATE_PROJECTS=true

# ---------- OVERWRITE (all default false) ----------
# Everything except OVERWRITE_LFS, plus SYNC_EXISTING=git, requires typing DELETE
# (or --yes / ASSUME_YES=true).
OVERWRITE_REPOS=false
OVERWRITE_ORGS=false             # deletes the org AND all repos inside it
OVERWRITE_GISTS=false
OVERWRITE_WEBHOOKS=false
OVERWRITE_ORG_WEBHOOKS=false
OVERWRITE_DEPLOY_KEYS=false
OVERWRITE_PROJECTS=false
OVERWRITE_LFS=false              # re-push LFS objects for existing repos (needs git + git-lfs, MIGRATE_LFS=true)

# ---------- BEHAVIOR ----------
SYNC_EXISTING=skip               # skip | git (lowercase; git force-updates and prunes branches/tags)
VERIFY=true
VERIFY_ALL=false
HOOKS_CREATE_INACTIVE=true       # true = migrated webhooks start disabled (avoids double CI)
GITHUB_AFFILIATION=owner         # e.g. owner,collaborator
PROJECTS_STATUS_FIELD=Status     # GitHub project field whose options become columns
# DRY_RUN=false                  # true = preview without changing Gitea
# ASSUME_YES=false               # true = skip the DELETE confirmation prompt
# LOG_FILE=migration.log         # default is a new timestamped file per run; a fixed name is appended to
# GH_MAX_WAIT=3700               # max seconds to sleep on a GitHub rate limit
